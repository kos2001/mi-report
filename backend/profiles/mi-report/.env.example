# MI Report 프로파일 시크릿 (복사: cp .env.example .env)

# --- Confluence 수집 ---
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# --- OpenRouter (embeddings / reranker / VLM, 그리고 chat 폴백) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- chat LLM 재정의 (선택) — hermes profile 'mi-report' 로 라우팅 ---
# hermes-agent 프로파일(~/.hermes/profiles/mi-report)의 OpenAI 호환 api_server 를 사용.
# 토큰: ~/.hermes/profiles/mi-report/config.yaml -> platforms.api_server.token
# 미설정 시 chat 도 위 OPENROUTER_* 를 그대로 사용한다.
MI_LLM_BASE_URL=http://127.0.0.1:8644/v1
MI_LLM_API_KEY=
MI_LLM_MODEL=mi-report

# --- 사내 LLM 게이트웨이 식별 헤더 (x-service-id / x-user-id). 사내 사용 시 채움 ---
LLM_SERVICE_ID=
LLM_USER_ID=

# --- 검색/랭킹 ---
MI_EMBEDDINGS=1
MI_EMBED_BACKEND=openrouter
MI_EMBED_MODEL=baai/bge-m3
MI_RERANK_MODEL=cohere/rerank-v3.5
